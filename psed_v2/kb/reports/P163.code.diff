+    base = float(re.match(r"[-+−]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+−]?\d+)?", m.group(0)).group(0).replace("−", "-"))
+    exp = (m.group(1) or (m.group(2) or "").translate(SUPERSCRIPT)).replace("−", "-")
+    return (base * 10 ** int(exp) if exp else base), rest
