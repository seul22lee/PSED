+def legend_number(t):
+    """P163: a text that is a number (n, n.n, n e m, n × 10^m, n × 10⁵) and then nothing or a unit units.yaml knows -> (value, unit as
+    printed); else None."""
+    t = t.strip()
+    m = LEGEND_NUMBER.match(t)
+    if not m:
+        return None
+    rest = t[m.end():].strip()
