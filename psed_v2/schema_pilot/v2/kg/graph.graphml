<node id="sample:gre23:R120"><data key="n_type">sample</data><data key="n_paper">gre23</data><data key="n_label">gre23:R120</data><data key="n_kind">run</data><data key="n_label_as_printed">120</data><data key="n_material">ZnO</data><data key="n_precursor">DEZ (diethylzinc)</data><data key="n_coreactant">H2O</data><data key="n_process_mode">thermal ALD, static dosing (pulse then closed-chamber hold)</data><data key="n_reactor">ALD NanoSolutions (Forge Nano) custom RX-series; roughly horizontal cylindrical chamber about 20 cm long, 10 cm ID, isolation valve to pump</data><data key="n_structure_class">nanoparticle compact</data><data key="n_structure_dims">pressed alpha-Al2O3 NP disc: thickness 2L = 1.55 mm (L = 0.78 mm), diameter 11.43 mm, d_NP ~ d_pore ~ 100 nm, initial porosity 50.5%, AR = L/d_pore = 7800; precursors enter both faces</data><data key="n_width_kind">d</data><data key="n_note">20-cycle ZnO run; T held at 120 C for every step; two NPCs coated together</data><data key="n_evidence">tabI.r1c0, tabII.r1c0, tabI.r0c0, tabII.r0c0, s9.p6, fig1; run (1) of three, sample label 120 in both tables, schedule in Fig. 1b</data></node>
