<node id="value:mat22:v227"><data key="n_type">value</data><data key="n_paper">mat22</data><data key="n_label">S/Mo ratio = 3.4</data><data key="n_sample_id">mat22:h2gas</data><data key="n_quantity">other</data><data key="n_label_as_printed">S/Mo ratio</data><data key="n_value">3.4</data><data key="n_data_kind">measured</data><data key="n_method">xps</data><data key="n_note">text gives the 0.20 / 150 °C product as MoS3.4; H2 gas did not change it</data><data key="n_evidence">s3.p52; stays a-MoS3.4 like the plain 0.20 process</data></node>
<node id="value:mat22:v228"><data key="n_type">value</data><data key="n_paper">mat22</data><data key="n_label">crystallinity = crystalline</data><data key="n_sample_id">mat22:lowH2S_250</data><data key="n_quantity">crystallinity</data><data key="n_value">crystalline</data><data key="n_data_kind">measured</data><data key="n_method">raman</data><data key="n_evidence">s3.p53; reduced H2S flow gives crystalline film at 250 °C without H2</data></node>
<node id="value:mat22:v229"><data key="n_type">value</data><data key="n_paper">mat22</data><data key="n_label">crystallinity = amorphous</data><data key="n_sample_id">mat22:lowH2S_150</data><data key="n_quantity">crystallinity</data><data key="n_value">amorphous</data><data key="n_data_kind">measured</data><data key="n_method">raman</data><data key="n_note">inferred from 'addition of H2 was necessary'</data><data key="n_evidence">s3.p53; at 150 °C H2 still needed for c-MoS2</data></node>
